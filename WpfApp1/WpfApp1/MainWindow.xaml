<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор (Командный проект)" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Режим работы:" FontWeight="Bold" Margin="0,0,0,5"/>
            <RadioButton x:Name="ModeDraw" Content="1. Рисование границы" IsChecked="True" Margin="0,5"/>
            <RadioButton x:Name="ModeFillColor" Content="2. Заливка цветом (Зад. 1а)" Margin="0,5"/>
            <RadioButton x:Name="ModeFillPattern" Content="3. Заливка рисунком (Зад. 1б)" Margin="0,5"/>

            <Separator Margin="0,15"/>

            <Button Content="Загрузить рисунок для заливки" Click="LoadPattern_Click" Margin="0,5" Padding="5"/>
            <TextBlock x:Name="PatternStatus" Text="Паттерн не загружен" FontSize="11" TextWrapping="Wrap" Margin="0,5" Foreground="Gray"/>

            <Separator Margin="0,15"/>

            <Button Content="Очистить холст" Click="ClearCanvas_Click" Margin="0,5" Padding="5"/>

            <TextBlock Text="Инструкция:" FontWeight="Bold" Margin="0,20,0,5"/>
            <TextBlock Text="1. Выберите 'Рисование границы' и нарисуйте замкнутую область мышкой (с зажатой ЛКМ)." TextWrapping="Wrap" FontSize="11" Margin="0,5"/>
            <TextBlock Text="2. Выберите режим заливки и кликните внутри замкнутой области." TextWrapping="Wrap" FontSize="11" Margin="0,5"/>
            <TextBlock Text="3. Для 1б предварительно загрузите изображение-паттерн." TextWrapping="Wrap" FontSize="11" Margin="0,5"/>
        </StackPanel>

        <!-- Холст -->
        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Background="White">
            <Image x:Name="CanvasImage" 
                   MouseLeftButtonDown="CanvasImage_MouseLeftButtonDown"
                   MouseMove="CanvasImage_MouseMove"
                   MouseLeftButtonUp="CanvasImage_MouseLeftButtonUp"
                   Stretch="None"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>
        </Border>
    </Grid>
</Window>
